generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLISHER
  VIEWER
}

enum StorageProvider {
  GOOGLE_DRIVE
  S3_COMPATIBLE
}

enum BuildStatus {
  PROCESSING
  PUBLISHED
}

enum Environment {
  PRODUCTION
  STAGING
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // Null = password was reset by an admin; the user signs in with their
  // email as the password once, then must choose a new one.
  passwordHash String?
  role         Role     @default(PUBLISHER)
  createdAt    DateTime @default(now())

  // Each publisher's own GitHub PAT, so build comments on issues are posted
  // under their name. AES-256-GCM encrypted (lib/crypto.ts), never plaintext.
  githubTokenEncrypted String?
  githubLogin          String?
  githubTokenSetAt     DateTime?

  builds       Build[]
  buildUpdates BuildUpdate[]
}

model Application {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  platform         String             @default("Android, APK")
  initials         String
  defaultStorageId String?
  defaultStorage   StorageConnection? @relation(fields: [defaultStorageId], references: [id])
  createdAt        DateTime           @default(now())

  builds Build[]
}

model StorageConnection {
  id                   String          @id @default(cuid())
  name                 String
  provider             StorageProvider
  accountLabel         String
  isDefault            Boolean         @default(false)
  encryptedCredentials String
  usedBytesApprox      BigInt          @default(0)
  createdAt            DateTime        @default(now())

  applications Application[]
  builds       Build[]
}

model Build {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String

  version      String
  number       String
  feature      String
  releaseNotes String?

  developer   User   @relation(fields: [developerId], references: [id])
  developerId String

  status       BuildStatus @default(PROCESSING)
  hasInspector Boolean     @default(false)
  environment  Environment @default(PRODUCTION)

  storageConnection   StorageConnection? @relation(fields: [storageConnectionId], references: [id])
  storageConnectionId String?
  storageObjectKey    String?
  apkFileName         String?
  apkSizeBytes        BigInt?

  // Opaque, unguessable token for the public /share/[token] page — separate
  // from the app slug + build number so a public link never lets someone
  // enumerate other builds or applications.
  shareToken String? @unique

  createdAt DateTime @default(now())

  tickets BuildTicket[]
  updates BuildUpdate[]

  // A build number identifies one APK within an app (PRD 7.4).
  @@unique([applicationId, number])
  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  // Storage → Clean up checks each stored file against builds.
  @@index([storageConnectionId, storageObjectKey])
}

enum CommentStatus {
  PENDING
  POSTED
  FAILED
}

model BuildTicket {
  id      String @id @default(cuid())
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  repo    String
  number  Int
  title   String
  htmlUrl String

  commentStatus CommentStatus @default(PENDING)
  commentError  String?

  createdAt DateTime @default(now())

  @@unique([buildId, repo, number])
}

// One row per "Replace APK" on an existing build. The build keeps its id,
// number and share token, so every existing download link now serves the
// new file; this keeps the history of what changed and why.
model BuildUpdate {
  id      String @id @default(cuid())
  build   Build  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  buildId String

  note String?

  apkFileName         String
  apkSizeBytes        BigInt
  previousApkFileName String?

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  createdAt DateTime @default(now())

  @@index([buildId, createdAt])
}
